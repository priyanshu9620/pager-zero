# Copy to .env and fill in. Only the key for LLM_PROVIDER is needed.

# ---- LLM (pick one block) ----
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-3.8-flash
# GOOGLE_API_KEY=

# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=

# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:14b

# ---- agent ----
MAX_STEPS=12

# ---- data backend: synthetic (default, offline) | live ----
ADAPTER_BACKEND=synthetic
# PROMETHEUS_URL=http://localhost:9090
# KAFKA_BOOTSTRAP=localhost:9092
# REDIS_URL=redis://localhost:6379/0
# GITHUB_TOKEN=

# ---- storage (phase 4+) ----
DATABASE_URL=postgresql+psycopg://pz:pz@localhost:5432/pagerzero
